// 値の出典はDESIGN.mdの前書き。darkだけを置く。lightは画面が揃ってから足す。
export global Tokens {
    out property <color> sidebar: #09090a;
    out property <color> canvas: #121213;
    out property <color> surface: #1a1a1b;
    out property <color> surface-hover: #171718;
    out property <color> selection: #1b1b1c;
    out property <color> border: #212224;
    out property <color> text-primary: #e2e4e7;
    out property <color> text-secondary: #8a8f98;
    out property <color> focus-ring: #8a8f98;
    out property <color> error-text: #ff977d;
    out property <length> row-height: 44px;
}
